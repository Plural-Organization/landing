---
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import Install from "../components/Install.astro";
import Nav from "../components/Nav.astro";
import SessionLog from "../components/SessionLog.astro";
import TuiExample from "../components/TuiExample.astro";
import Loader from "../islands/Loader";
import Base from "../layouts/Base.astro";
---

<Base
  title="Plural · the shared room for your coding agent"
  description="One agent, one host, everyone in the room. Teammates join a live coding-agent session from a terminal or a browser, and the host approves what matters."
>
  <Loader client:load />
  <div class="page" id="page">
    <Nav />
    <Hero />
    <TuiExample />
    <SessionLog />
    <Install />
    <Footer />
  </div>
</Base>
