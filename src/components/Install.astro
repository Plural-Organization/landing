---
import CopyButton from "../islands/CopyButton";
import { INSTALL, WEB_CLIENT } from "../data/site";

const start = "cd your-project && plural";
---

<section id="install">
  <div class="wrap go">
    <div>
      <h2>open your own room.</h2>
      <p class="lede">macOS and Linux, arm64 and x64, Windows through WSL. Without a key the host runs a scripted demo agent.</p>
    </div>
    <div class="term">
      <div class="line"><code>{INSTALL}</code><CopyButton client:visible text={INSTALL} /></div>
      <div class="line"><code>{start}</code><span class="c">you host</span><CopyButton client:visible text={start} /></div>
      <div class="line"><code>plural join "ws://…"</code><span class="c">a teammate joins</span></div>
      <div class="line">
        <a class="web" href={WEB_CLIENT} target="_blank" rel="noopener">or join from the browser →</a><span class="c">no install</span>
      </div>
    </div>
  </div>
</section>
